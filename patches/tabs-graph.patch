+// cyber-romo: when the panel's stack holds git-changes and git-graph, they are one
+// panel, Changes with its History tab (mods/git-changes/fused.js): no Graph
+// button, and Changes stands for both. The child ids they sit under, or null.
+function gitPair(body) {
+  const kids = body?.children ?? [], mod = (c) => (c.type === "block" ? c.content?.mod : null);
+  const changes = kids.find((c) => mod(c) === "git-changes"), graph = kids.find((c) => mod(c) === "git-graph");
+  return changes && graph ? { changes: changes.id, graph: graph.id } : null;
+}
